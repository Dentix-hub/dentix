{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dentix-dentix.hf.space/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|icons/|sw\\.js|workbox-|registerSW\\.js|manifest\\.webmanifest|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
