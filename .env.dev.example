# =============================================================
# Dentix LOCAL DEVELOPMENT Environment Variables
# Copy to .env and fill in your values:
#   cp .env.dev.example .env
# =============================================================

# ⚠️ DATABASE CONFIGURATION
# By default, a local PostgreSQL container runs on port 5432 via docker-compose.dev.yml.
# Connect to it using the credentials below:
DATABASE_URL=postgresql://postgres:local-dev-password@localhost:5432/dentix_dev
DB_SSL_MODE=disable

# LOCAL PORTS CONFIGURATION (Change if you have conflicts on your machine)
BACKEND_PORT=7860
FRONTEND_PORT=5173
REDIS_PORT=6379

# SECURITY (use different keys for dev!)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-me-in-production
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# AI SERVICES
GROQ_API_KEY=your_groq_api_key

# FILE STORAGE (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# TOKEN CONFIG
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SUPER ADMIN (first setup only — remove after)
SUPER_ADMIN_EMAIL=admin@dentixs.app
SUPER_ADMIN_PASSWORD=change-me

# REDIS (auto-configured by docker-compose.dev.yml — don't set manually)
# REDIS_URL=redis://redis:6379/0
