# Environment Variables Template
# Copy this file to .env and fill in your values
# Last updated: Phase A (A2.7) — Added all required variables

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/smart_clinic
# Required with PostgreSQL: a distinct login carrying native BYPASSRLS for
# narrowly scoped system/auth/worker operations. DATABASE_URL must be NOBYPASSRLS.
SYSTEM_DATABASE_URL=postgresql://dentix_system@localhost:5432/smart_clinic
DB_SSL_MODE=require
# SQLAlchemy pool defaults are conservative for PgBouncer/Supabase. Tune only
# after checking the provider's client limit and Dentix pool metrics.
# DB_POOL_SIZE=3
# DB_POOL_MAX_OVERFLOW=2
# DB_POOL_TIMEOUT=15
# DB_POOL_RECYCLE=300
# DB_CONNECTION_HOLD_WARN_SECONDS=5
# ERROR_LOG_DB_TIMEOUT_SECONDS=2

# ============================================
# SECURITY KEYS (CRITICAL — Generate new ones!)
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your_secret_key_here_min_64_chars_never_reuse

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# ============================================
# APPLICATION
# ============================================
ENVIRONMENT=development
BACKEND_PUBLIC_URL=https://your-backend-url.com
FRONTEND_URL=https://your-frontend-url.com

# Production reverse-proxy domains. WWW_DOMAIN is redirected permanently to DOMAIN
# so authentication cookies and iframe/navigation origins never split across hosts.
DOMAIN=dentixs.app
WWW_DOMAIN=www.dentixs.app

# Comma-separated list of allowed CORS origins (CRITICAL for production)
# Must include the frontend domain. Example: https://app.dentixs.app
CORS_ORIGINS=https://your-frontend-url.com

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
DEBUG=False

# ============================================
# AI SERVICES
# ============================================
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# FILE STORAGE (Optional — Cloudinary)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============================================
# GOOGLE OAUTH (Optional — Google Drive Backup)
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend-url.com/api/v1/settings/backup/callback

# ============================================
# FIREBASE (Push Notifications)
# ============================================
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================
# SUPER ADMIN (First Setup Only)
# ============================================
# Set these for initial setup, then remove after first admin is created
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your-secure-admin-password

# ============================================
# TOKEN CONFIGURATION
# ============================================
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# MONITORING & ALERTS (Optional)
# ============================================
# REDIS_URL=redis://localhost:6379
# SENTRY_DSN=your_sentry_dsn
# SLACK_WEBHOOK_URL=your_slack_webhook

# Required for signed subscription payment webhooks (minimum 32 random characters).
# Providers must sign: <X-Webhook-Timestamp>.<raw-request-body> using HMAC-SHA256.
SUBSCRIPTION_WEBHOOK_SECRET=

# ============================================
# GUARDED PLATFORM BACKUPS (Optional)
# ============================================
# URL-safe base64 encoding of exactly 32 random bytes. Keep outside backup storage.
DENTIX_BACKUP_ENCRYPTION_KEY=
# Non-secret key/version identifier used in the recovery manifest.
DENTIX_BACKUP_KEY_ID=
# Durable system backup scheduling is opt-in and requires the worker process.
BACKUP_SCHEDULER_ENABLED=false
BACKUP_SCHEDULER_INTERVAL_SECONDS=86400
BACKUP_MISSED_RUN_GRACE_SECONDS=3600
# Optional dedicated read-only backup URL; defaults to SYSTEM_DATABASE_URL so
# full-platform dumps cannot silently omit tenant rows under the app role.
BACKUP_SOURCE_DATABASE_URL=
BACKUP_OUTPUT_DIR=backups/offline
